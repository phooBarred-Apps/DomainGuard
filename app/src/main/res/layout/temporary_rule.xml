<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <androidx.appcompat.widget.SwitchCompat android:id="@+id/temporary_rule_enabled"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
        android:text="@string/temporary_rule" android:checked="false" />
    <LinearLayout android:id="@+id/temporary_rule_fields" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <EditText android:id="@+id/temporary_rule_amount" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number"
                android:singleLine="true" android:selectAllOnFocus="true" android:importantForAutofill="no"
                android:hint="@string/app_pause_duration_label" />
            <heartguard.heartguard.main.AppPauseUnitSpinner android:id="@+id/temporary_rule_unit"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                android:contentDescription="@string/rule_delay_unit_label" android:spinnerMode="dialog" />
        </LinearLayout>
        <TextView android:id="@+id/temporary_rule_summary" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textAppearance="@style/TextSmall" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_pause_maximum" android:textStyle="italic" android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>
