<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fadeScrollbars="false" android:scrollbarStyle="insideOverlay">
    <LinearLayout android:id="@+id/global_pause_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="12dp" android:focusableInTouchMode="true">
        <androidx.appcompat.widget.SwitchCompat android:id="@id/global_pause_auto_resume" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/global_auto_resume" />
        <TextView android:id="@+id/global_off_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="20dp" android:text="@string/global_off_description" android:textAppearance="@style/TextMedium" />
        <LinearLayout android:id="@+id/global_pause_duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingTop="8dp" android:paddingBottom="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@id/global_pause_amount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:singleLine="true" android:importantForAutofill="no" android:hint="@string/app_pause_duration_label" />
                <heartguard.heartguard.main.AppPauseUnitSpinner android:id="@id/global_pause_unit" android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginStart="16dp" android:contentDescription="@string/rule_delay_unit_label" android:spinnerMode="dialog" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_pause_maximum" android:textStyle="italic" android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
