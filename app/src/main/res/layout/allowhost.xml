<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true" android:fadeScrollbars="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:focusableInTouchMode="true">
        <TextView android:id="@+id/allow_new_access_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextLarge" android:layout_marginBottom="12dp" />
        <LinearLayout android:id="@+id/domain_input_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="?android:attr/editTextBackground" android:addStatesFromChildren="true" android:padding="0dp">
            <EditText android:id="@+id/allow_new_access_daddr" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:singleLine="true" android:inputType="textUri" android:importantForAutofill="no" android:textSize="15sp" android:hint="@string/domain_hint" android:background="@android:color/transparent" android:paddingStart="0dp" android:paddingEnd="0dp" />
            <heartguard.heartguard.main.CompactImageButton android:id="@+id/domain_parent_choices" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_dropdown_compact" android:contentDescription="@string/domain_choose_parent" />
        </LinearLayout>
        <TextView android:id="@+id/domain_parent_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/domain_includes_subdomains" android:textAppearance="@style/TextSmall" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <ImageView android:id="@+id/domain_scope_icon" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/allow_new_access_package_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="@style/TextMedium" />
            <heartguard.heartguard.main.CompactImageButton android:id="@+id/allow_new_access_global" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_globe_compact" android:contentDescription="@string/scope_off" />
        </LinearLayout>
        <TextView android:id="@+id/domain_action_delay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawableStart="@drawable/ic_history_compact" android:drawablePadding="8dp" android:gravity="center_vertical" android:textAppearance="@style/TextSmall" android:visibility="gone" />
        <include layout="@layout/temporary_rule" />
    </LinearLayout>
</ScrollView>
