<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <androidx.appcompat.widget.SearchView android:id="@+id/global_list_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    <TextView android:id="@+id/global_list_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="8dp" android:textAppearance="@style/TextSmall" />
    <TextView android:id="@+id/whitelist_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:textAppearance="@style/TextMedium" />
    <ListView android:id="@+id/whitelist_entries" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="vertical" android:scrollbarStyle="insideOverlay" android:fadeScrollbars="false" android:dividerHeight="0dp" />
</LinearLayout>
