<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:focusableInTouchMode="true">
    <include layout="@layout/raw_search_navigation" />
    <TextView android:id="@+id/rawRulesEmpty"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:padding="24dp" android:visibility="gone"
        android:text="@string/raw_rules_empty" />
    <heartguard.heartguard.main.FastScrollListView
        android:id="@+id/lvRulesList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:paddingStart="4dp" android:paddingEnd="24dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" />
</LinearLayout>
