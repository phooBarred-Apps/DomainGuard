<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
        <Button android:id="@+id/recent_window" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="start|center_vertical" android:textAllCaps="false" android:background="?attr/selectableItemBackgroundBorderless" />
        <heartguard.heartguard.main.CompactImageButton android:id="@+id/recent_domain_filter" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_filter_list_white_24dp" android:contentDescription="@string/domain_filters" />
        <heartguard.heartguard.main.CompactImageButton android:id="@+id/recent_sort" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_sort_white_24dp" android:tint="?android:attr/textColorSecondary" android:contentDescription="@string/list_sort_domains" />
        <heartguard.heartguard.main.CompactImageButton android:id="@+id/recent_hidden" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_visibility_off_compact" android:contentDescription="@string/recent_traffic_hidden_title" />
        <heartguard.heartguard.main.CompactImageButton android:id="@+id/recent_help" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp" android:src="@drawable/ic_info_compact" android:contentDescription="@string/recent_traffic_help_label" />
    </LinearLayout>
    <TextView android:id="@+id/recent_protection_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:textAppearance="@style/TextSmall" android:text="@string/recent_traffic_protection_off" android:visibility="gone" />
    <TextView android:id="@+id/recent_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="4dp" android:textAppearance="@style/TextSmall" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recent_list" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="vertical" android:fadeScrollbars="false" />
        <TextView android:id="@+id/recent_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:padding="24dp" android:text="@string/recent_traffic_loading" android:textAppearance="@style/TextMedium" />
    </FrameLayout>
    <Button android:id="@+id/recent_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAllCaps="false" android:background="?attr/selectableItemBackgroundBorderless" android:text="@string/recent_traffic_more" android:visibility="gone" />
</LinearLayout>
