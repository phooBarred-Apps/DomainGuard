<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/filter_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:fadeScrollbars="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="96dp" android:layout_height="wrap_content" android:text="@string/list_filter_access" android:labelFor="@+id/filter_access" />
            <Spinner android:id="@id/filter_access" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:entries="@array/list_access_choices" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="96dp" android:layout_height="wrap_content" android:text="@string/list_filter_activity" android:labelFor="@+id/filter_activity" />
            <Spinner android:id="@id/filter_activity" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:entries="@array/list_activity_choices" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="96dp" android:layout_height="wrap_content" android:text="@string/list_filter_type" android:labelFor="@+id/filter_type" />
            <Spinner android:id="@id/filter_type" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:entries="@array/list_type_choices" />
        </LinearLayout>
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/filter_no_internet" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/list_include_no_internet" />
        <androidx.appcompat.widget.SwitchCompat android:id="@+id/filter_disabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/list_include_disabled" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/filter_default" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/list_set_default" android:textAllCaps="false" android:background="?attr/selectableItemBackgroundBorderless" />
            <Button android:id="@+id/filter_reset" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/reset_short" android:contentDescription="@string/reset_search_filters" android:textAllCaps="false" android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
