<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filter_scroll"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/list_filter_access" android:labelFor="@+id/filter_access" />
        <Spinner android:id="@id/filter_access" android:layout_width="match_parent"
            android:layout_height="48dp" android:entries="@array/list_access_choices" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/list_filter_explanation" android:textAppearance="@style/TextSmall" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/list_filter_activity" android:labelFor="@+id/filter_activity" />
        <Spinner android:id="@id/filter_activity" android:layout_width="match_parent"
            android:layout_height="48dp" android:entries="@array/list_activity_choices" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/list_filter_type" android:labelFor="@+id/filter_type" />
        <Spinner android:id="@id/filter_type" android:layout_width="match_parent"
            android:layout_height="48dp" android:entries="@array/list_type_choices" />
        <CheckBox android:id="@+id/filter_no_internet" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/list_include_no_internet" />
        <CheckBox android:id="@+id/filter_disabled" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/list_include_disabled" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/list_filter_default_explanation"
            android:textAppearance="@style/TextSmall" />
        <Button android:id="@+id/filter_reset" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/list_reset_filters" />
    </LinearLayout>
</ScrollView>
