<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:fadeScrollbars="false" android:scrollbarStyle="insideOverlay">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="8dp" android:focusableInTouchMode="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/app_pause_icon" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/app_pause_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textAppearance="@style/TextMedium" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_pause_description" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/app_pause_shared" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/app_pause_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextMedium" />
        <Button android:id="@+id/app_pause_state_action" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:minWidth="0dp" android:padding="0dp" android:gravity="start|center_vertical" android:background="?attr/selectableItemBackgroundBorderless" android:textAllCaps="false" android:text="@string/app_pause_resume" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <EditText android:id="@+id/app_pause_amount" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="number" android:singleLine="true" android:selectAllOnFocus="true" android:importantForAutofill="no" android:hint="@string/app_pause_duration_label" />
            <heartguard.heartguard.main.AppPauseUnitSpinner android:id="@+id/app_pause_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:contentDescription="@string/rule_delay_unit_label" android:spinnerMode="dialog" />
        </LinearLayout>
        <TextView android:id="@+id/app_pause_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_pause_maximum" android:textStyle="italic" android:layout_marginTop="8dp" />
    </LinearLayout>
</ScrollView>
